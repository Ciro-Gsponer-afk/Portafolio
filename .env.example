# Copiar este archivo como ".env" y completar con los datos reales.
# El archivo ".env" NO se sube a Git (ya está en .gitignore).

# Clave para firmar las sesiones de Flask (inventar una larga y aleatoria)
SECRET_KEY=cambiar-esta-clave-por-una-larga-y-aleatoria

# Modo de desarrollo: muestra errores detallados. En producción debe ser 0.
FLASK_DEBUG=1

# Conexión a MySQL.
# Formato: mysql+mysqlconnector://usuario:password@host:puerto/nombre_base
# En local:
DATABASE_URL=mysql+mysqlconnector://root:tu_password@localhost:3306/portafolio_db
# En Clever Cloud, reemplazar host, usuario, password y nombre por los del panel.

# Link embebible (YouTube, Vimeo, etc.) del iframe "Demo en vivo".
# Ejemplo: https://www.youtube.com/embed/ID_DEL_VIDEO
DEMO_URL=
