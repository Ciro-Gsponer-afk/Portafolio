# Copiar este archivo como ".env" y completar con los datos reales.
# El archivo ".env" NO se sube a Git (ya está en .gitignore).

# Clave para firmar las sesiones de Flask (inventar una larga y aleatoria)
SECRET_KEY=cambiar-esta-clave-por-una-larga-y-aleatoria

# Modo de desarrollo: muestra errores detallados. En producción debe ser 0.
FLASK_DEBUG=1

# Conexión a MySQL.
# Formato: mysql+mysqlconnector://usuario:password@host:puerto/nombre_base
# En LOCAL se usa esta línea (el .env NO se sube a Git):
DATABASE_URL=mysql+mysqlconnector://root:tu_password@localhost:3306/portafolio_db

# En CLEVER CLOUD NO hay que copiar la contraseña acá: al linkear el add-on
# MySQL, la plataforma inyecta MYSQL_ADDON_HOST / PORT / DB / USER / PASSWORD
# y app/config.py arma la DATABASE_URL automáticamente.
# Si se usa otro hosting (Render, por ejemplo), sí hay que definir
# DATABASE_URL a mano con los datos del proveedor de MySQL.

# Link embebible (YouTube, Vimeo, etc.) del iframe "Demo en vivo".
# Ejemplo: https://www.youtube.com/embed/ID_DEL_VIDEO
# Si está vacío, la vista muestra un aviso en lugar del iframe.
DEMO_URL=

# Estas variables se configuran en el PANEL del hosting, no en este .env:
# CC_PYTHON_MODULE=run:app
# CC_PYTHON_BACKEND=gunicorn
# CC_PYTHON_VERSION=3.13
# FLASK_DEBUG=0
