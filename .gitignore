# Secretos: nunca subir credenciales reales a Git
.env

# Entorno virtual de Python
.venv/
venv/
env/

# Archivos generados por Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Archivos subidos por el usuario (se guardan en la carpeta static/uploads)
app/static/uploads/*
!app/static/uploads/.gitkeep

# Editor / sistema
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log
